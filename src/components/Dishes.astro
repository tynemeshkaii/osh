---
import Section from '@/components/Section.astro';
import Carousel from '@/components/Carousel.astro';
import { content } from '@/content/schema';

const { dishes } = content;
// Narrower slides than the gallery: the next plate peeking in is part of the appetite.
const slides = dishes.items.map((item) => ({ src: item.src, alt: item.alt, title: item.name, note: item.note }));
---

<Section id="dishes" heading={dishes.heading} sub={dishes.sub} surface>
  <Carousel slides={slides} aspect="1 / 1" width="72%" widthMd="32%" label={dishes.heading} />
</Section>
