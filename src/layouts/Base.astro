---
import '@/styles/global.css';
import { content, HERO_VARIANTS, DRAFT } from '@/content/schema';
import { asset } from '@/lib/assets';

const { seo, hero, draft, _meta } = content;
const variants = HERO_VARIANTS;
const defaultVariant = hero.defaultVariant;
const fonts = {
  display: asset('/fonts/display-medium.woff2'),
  sans: asset('/fonts/sans-regular.woff2'),
  sansMedium: asset('/fonts/sans-medium.woff2'),
};
---

<!doctype html>
<html lang={_meta.locale} data-variant={defaultVariant}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#FAF8F5" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={asset('/img/og.jpg')} />
    <meta property="og:image:alt" content={seo.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <!-- Cormorant Garamond 500 (display) + Google Sans 400/500 (UI), subset to latin/latin-ext, ~20 KB each.
         Only the display face takes part in LCP (H1). Other faces load on demand. -->
    <link rel="preload" href={fonts.display} as="font" type="font/woff2" crossorigin />
    <!-- @font-face is inlined (not bundled) so Vite does not try to resolve
         font files at build time; they are served straight from /public/fonts. -->
    <style is:inline set:html={`
      @font-face {
        font-family: 'OSH Display';
        src: url('${fonts.display}') format('woff2');
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'OSH Sans';
        src: url('${fonts.sans}') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'OSH Sans';
        src: url('${fonts.sansMedium}') format('woff2');
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }
    `} />

    <!-- Hero variant from ?v=view|business|price. Runs before first paint so
         there is no flash of the wrong headline. Only the hero copy changes. -->
    <script is:inline define:vars={{ variants, defaultVariant }}>
      (function () {
        try {
          var v = new URLSearchParams(location.search).get('v');
          document.documentElement.dataset.variant =
            v && variants.indexOf(v) !== -1 ? v : defaultVariant;
        } catch (_) {
          document.documentElement.dataset.variant = defaultVariant;
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="bg-bg text-ink font-sans antialiased">
    {DRAFT && (
      <p class="bg-ink px-4 py-2 text-center text-small text-white/90" role="note">{draft.banner}</p>
    )}
    <slot />
  </body>
</html>
