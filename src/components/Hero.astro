---
import { content, HERO_VARIANTS, finalList } from '@/content/schema';
import { asset } from '@/lib/assets';
import { whatsappHref } from '@/lib/links';

const { hero, footer } = content;
// One trust strip per variant; placeholders (e.g. {{BUSINESS_FACT}}) drop out of non-draft builds.
const trust = Object.fromEntries(HERO_VARIANTS.map((id) => [id, finalList(hero.variants[id].trustStrip)]));
const waHref = whatsappHref(footer.phone, hero.whatsappMessage);
const poster = asset(hero.media.poster);
const video = asset(hero.media.video);
---

<section data-hero class="relative flex min-h-[100svh] max-h-[812px] flex-col overflow-hidden text-white">
  <!-- The section is the fixed box (100svh, ≤812px); the video covers it.
       Poster paints first (LCP), video takes over once it can autoplay.
       Draft asset: source clip as-is, not yet cut/compressed to the 1.5 MB budget. -->
  <video
    class="absolute inset-0 h-full w-full object-cover"
    src={video}
    poster={poster}
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-label={hero.media.alt}
  ></video>
  <div class="absolute inset-0 bg-overlay" aria-hidden="true"></div>

  <div class="relative mx-auto flex w-full max-w-[640px] flex-1 flex-col justify-end px-4 pb-8 pt-12 md:pb-12">
    <p class="text-small font-medium uppercase tracking-[0.12em] opacity-90">{hero.eyebrow}</p>

    {HERO_VARIANTS.map((id) => (
      <div data-hero-variant={id}>
        <h1 class="mt-4 text-h1 md:text-[48px] md:leading-[1.08]">{hero.variants[id].h1}</h1>
        <p class="mt-4 text-body opacity-90 md:text-[18px]">{hero.variants[id].sub}</p>
      </div>
    ))}

    <a
      href="#booking"
      class="mt-6 inline-flex min-h-[52px] w-full items-center justify-center rounded-pill bg-accent px-6 text-body font-medium text-accent-ink md:w-auto md:self-start"
      data-cta="hero"
    >
      {hero.cta}
    </a>
    <p class="mt-3 text-small opacity-80">{hero.ctaMicrocopy}</p>
    <!-- Secondary path for people who would rather talk than fill a form.
         Client decision (Sept 2026): the one outbound link allowed above SocialProof. -->
    <a
      href={waHref}
      target="_blank"
      rel="noopener"
      class="mt-1 inline-flex min-h-[44px] items-center self-start text-small font-medium underline underline-offset-4"
      data-cta="whatsapp-hero"
    >
      {hero.ctaSecondary}
    </a>

    {HERO_VARIANTS.map((id) => trust[id]!.length > 0 && (
      <div data-hero-variant={id}>
        <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1 border-t border-white/25 pt-4 text-small opacity-90">
          {trust[id]!.map((line) => <li>{line}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>
