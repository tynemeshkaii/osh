---
import Section from '@/components/Section.astro';
import { content, finalList, finalText } from '@/content/schema';

const { offer } = content;
---

<Section id="offer" heading={offer.heading} sub={offer.sub}>
  <div class="grid gap-4 md:grid-cols-2">
    {offer.cards.map((card) => {
      const items = finalList(card.items);
      const footnote = finalText(card.footnote);
      return (
        <article class="flex flex-col rounded-card border border-line bg-surface p-6" data-offer={card.id}>
          {card.badge && (
            <span class="mb-3 self-start rounded-pill bg-accent px-3 py-1 text-small font-medium text-accent-ink">
              {card.badge}
            </span>
          )}
          <h3 class="text-h3">{card.title}</h3>
          <p class="mt-2 text-body font-medium">{card.price}</p>
          {items.length > 0 && (
            <ul class="mt-4 space-y-2 text-body text-muted">
              {items.map((item) => (
                <li class="flex gap-2">
                  <span class="mt-[10px] h-1 w-1 shrink-0 rounded-pill bg-accent" aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          )}
          {footnote && <p class="mt-4 text-small text-muted">{footnote}</p>}
          <a
            href="#booking"
            class="mt-6 inline-flex min-h-[48px] items-center justify-center rounded-pill border border-ink px-5 text-body font-medium"
            data-cta={`offer-${card.id}`}
            data-select-offer={card.id}
          >
            {card.cta}
          </a>
        </article>
      );
    })}
  </div>
  <p class="mt-8 text-body text-muted">{offer.closing}</p>
</Section>
