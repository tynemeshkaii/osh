---
import { content } from '@/content/schema';
import { telHref } from '@/lib/links';

const { footer } = content;
---

<footer class="border-t border-line py-8 pb-[calc(32px+72px)] text-small text-muted">
  <div class="mx-auto w-full max-w-[640px] px-4">
    <p>{footer.address}</p>
    <p class="mt-2">
      <a href={telHref(footer.phone)} class="inline-flex min-h-[44px] items-center text-ink" data-cta="phone">{footer.phone}</a>
    </p>
    <p class="mt-2">{footer.copyright}</p>
  </div>
</footer>
