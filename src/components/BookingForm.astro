---
import Section from '@/components/Section.astro';
import { content, DRAFT } from '@/content/schema';
import { whatsappHref } from '@/lib/links';
import { GUESTS_MIN, GUESTS_MAX, TIME_SLOTS } from '@/lib/validation';

/** Guest counts offered as pills; anything above opens the number input. */
const GUEST_PILLS = [1, 2, 3, 4, 5, 6] as const;
const GUESTS_DEFAULT = 2;
const GUESTS_MORE_FROM = Math.max(...GUEST_PILLS) + 1;

const { form, thanks, footer, links } = content;
const { step1, step2, progress, whatsappBlock } = form;
const waHref = whatsappHref(footer.phone, whatsappBlock.prefilledMessage);

/** "14:30" → "2:30 PM". Display only; the value stays HH:MM. */
const slotLabel = (slot: string) => {
  const [h, m] = slot.split(':').map(Number);
  const hour12 = h! % 12 || 12;
  return `${hour12}:${String(m).padStart(2, '0')} ${h! < 12 ? 'AM' : 'PM'}`;
};
const slots = TIME_SLOTS.map((value) => ({ value, label: slotLabel(value) }));

// Everything the client script needs from content, as one JSON island.
// Keeps copy out of the script and the whole content file out of the bundle.
const clientConfig = JSON.stringify({
  errors: form.errors,
  offerLabels: Object.fromEntries(step2.fields.offer.options.map((o) => [o.value, o.label])),
  seatingLabels: Object.fromEntries(step1.fields.seating.options.map((o) => [o.value, o.label])),
  summaryTemplate: thanks.summaryTemplate,
  ctaLoading: step2.ctaLoading,
  cta: step2.cta,
});

const inputClass =
  'mt-1 block h-12 w-full rounded-card border border-line bg-surface px-4 text-body outline-none focus:border-accent aria-[invalid=true]:border-error';
const labelClass = 'block text-small font-medium';
const errorClass = 'mt-1 text-small text-error';
const primaryBtn =
  'inline-flex min-h-[52px] w-full items-center justify-center rounded-pill bg-accent px-6 text-body font-medium text-accent-ink disabled:opacity-60';
// Pill-shaped choice: a button or a label wrapping a hidden radio. Selected state via aria-pressed / :checked.
const pillClass =
  'inline-flex min-h-[44px] cursor-pointer select-none items-center justify-center whitespace-nowrap rounded-pill border border-line bg-surface px-3 text-body transition-colors aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-white has-[:checked]:border-ink has-[:checked]:bg-ink has-[:checked]:text-white disabled:cursor-not-allowed disabled:opacity-40';
---

<Section id="booking" heading={form.heading} sub={form.sub}>
  <!-- Draft flow: step 1 → step 2 → thank-you panel, all client-side.
       Validation is the shared schema in src/lib/validation.ts.
       Nothing is sent yet; the submit handler is where the fetch to the
       Cloudflare Function will go. Field values are never cleared on error. -->
  <form id="booking-form" class="rounded-card border border-line bg-surface p-5 md:p-6" novalidate>
    <input type="hidden" name="variant" value="" data-variant-field />

    <fieldset data-step="1" class="border-0 p-0">
      <p class="text-small text-muted">{progress.step1}</p>
      <legend class="mt-1 text-h3">{step1.heading}</legend>

      <!-- Date: Today / Tomorrow / Pick a date. The native input is the single
           source of the value; quick picks just fill it and stay hidden. -->
      <fieldset class="mt-5 border-0 p-0" data-date-group>
        <legend class={labelClass}>{step1.fields.date.label}</legend>
        <div class="mt-2 flex flex-wrap gap-2" role="group">
          <button type="button" class={pillClass} data-date-quick="today" aria-pressed="false">{step1.fields.date.quick.today}</button>
          <button type="button" class={pillClass} data-date-quick="tomorrow" aria-pressed="false">{step1.fields.date.quick.tomorrow}</button>
          <button type="button" class={pillClass} data-date-quick="pick" aria-pressed="false">{step1.fields.date.quick.pick}</button>
        </div>
        <p class="mt-2 text-small text-muted" data-today-closed hidden>{step1.fields.date.todayClosed}</p>
        <label for="f-date" class="sr-only">{step1.fields.date.label}</label>
        <input id="f-date" name="date" type="date" class={inputClass} autocomplete="off" aria-describedby="e-date" hidden />
        <p id="e-date" class={errorClass} data-error-for="date" hidden></p>
      </fieldset>

      <!-- Time: one pill per seating from TIME_SLOTS. Radios, so the value
           travels with the form and keyboard/screen-reader users get a group. -->
      <fieldset class="mt-5 border-0 p-0" data-time-group>
        <legend class={labelClass}>{step1.fields.time.label}</legend>
        <div class="mt-2 grid grid-cols-3 gap-2">
          {slots.map((s) => (
            <label class={pillClass} data-slot={s.value}>
              <input type="radio" name="time" value={s.value} class="sr-only" />
              <span>{s.label}</span>
            </label>
          ))}
        </div>
        <p class={errorClass} data-error-for="time" hidden></p>
      </fieldset>

      <!-- Guests: one tap for 1–6; "7+" reveals the number input. The native
           input is the single source of the value, same pattern as the date. -->
      <fieldset class="mt-5 border-0 p-0" data-guests-group>
        <legend class={labelClass}>{step1.fields.guests.label}</legend>
        <div class="mt-2 flex flex-wrap gap-2" role="group">
          {GUEST_PILLS.map((n) => (
            <button type="button" class:list={[pillClass, 'min-w-[44px]']} data-guests-quick={n} aria-pressed={n === GUESTS_DEFAULT}>{n}</button>
          ))}
          <button type="button" class:list={[pillClass, 'min-w-[44px]']} data-guests-quick="more" aria-pressed="false">{step1.fields.guests.more}</button>
        </div>
        <label for="f-guests" class:list={['mt-3', labelClass]} data-guests-more-label hidden>{step1.fields.guests.moreLabel}</label>
        <input id="f-guests" name="guests" type="number" min={GUESTS_MIN} max={GUESTS_MAX} value={GUESTS_DEFAULT} data-more-from={GUESTS_MORE_FROM} inputmode="numeric" class={inputClass} autocomplete="off" aria-describedby="e-guests" hidden />
        <p id="e-guests" class={errorClass} data-error-for="guests" hidden></p>
      </fieldset>

      <!-- Seating: the ad sold the terrace, so we ask. Preselected "no preference" keeps it one optional tap. -->
      <fieldset class="mt-5 border-0 p-0">
        <legend class={labelClass}>{step1.fields.seating.label}</legend>
        <div class="mt-2 flex flex-wrap gap-2">
          {step1.fields.seating.options.map((opt) => (
            <label class={pillClass}>
              <input type="radio" name="seating" value={opt.value} checked={opt.default} class="sr-only" />
              <span>{opt.label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <button type="button" class:list={['mt-6', primaryBtn]} data-step-next>
        {step1.cta}
      </button>
    </fieldset>

    <fieldset data-step="2" class="border-0 p-0" hidden>
      <div class="flex items-baseline justify-between">
        <p class="text-small text-muted">{progress.step2}</p>
        <button type="button" class="min-h-[44px] text-small font-medium underline" data-step-back>{progress.back}</button>
      </div>
      <legend class="mt-1 text-h3">{step2.heading}</legend>

      <div class="mt-5 grid gap-4">
        <div>
          <label for="f-name" class={labelClass}>{step2.fields.name.label}</label>
          <input id="f-name" name="name" type="text" placeholder={step2.fields.name.placeholder} autocomplete="name" class={inputClass} required={step2.fields.name.required} aria-describedby="e-name" />
          <p id="e-name" class={errorClass} data-error-for="name" hidden></p>
        </div>
        <div>
          <label for="f-phone" class={labelClass}>{step2.fields.phone.label}</label>
          <input id="f-phone" name="phone" type="tel" inputmode="tel" placeholder={step2.fields.phone.placeholder} autocomplete="tel" class={inputClass} required={step2.fields.phone.required} aria-describedby="e-phone h-phone" />
          {step2.fields.phone.helper && <p id="h-phone" class="mt-1 text-small text-muted">{step2.fields.phone.helper}</p>}
          <p id="e-phone" class={errorClass} data-error-for="phone" hidden></p>
        </div>

        <!-- Offer: preselected, one tap to switch. Asked after contact, not before. -->
        <fieldset class="border-0 p-0">
          <legend class={labelClass}>{step2.fields.offer.label}</legend>
          <div class="mt-2 grid gap-2">
            {step2.fields.offer.options.map((opt) => (
              <label class={pillClass}>
                <input type="radio" name="offer" value={opt.value} checked={opt.default} class="sr-only" />
                <span>{opt.label}</span>
              </label>
            ))}
          </div>
          <p class={errorClass} data-error-for="offer" hidden></p>
        </fieldset>

        <!-- Notes: collapsed until wanted. Opens itself if there is text (e.g. after back/forward). -->
        <details data-notes>
          <summary class="inline-flex min-h-[44px] items-center text-small font-medium underline underline-offset-4">{step2.fields.notes.toggle}</summary>
          <label for="f-notes" class:list={['mt-2', labelClass]}>{step2.fields.notes.label}</label>
          <textarea id="f-notes" name="notes" rows="3" maxlength="500" placeholder={step2.fields.notes.placeholder} class={`${inputClass} h-auto py-3`} autocomplete="off"></textarea>
        </details>
      </div>

      <button type="submit" class:list={['mt-6', primaryBtn]} data-submit>
        {step2.cta}
      </button>
      <!-- Reassurance first (what happens next), consent last. -->
      <p class="mt-3 text-small text-muted">{step2.microcopy}</p>
      <p class="mt-2 text-small text-muted">{step2.consentNote}</p>
    </fieldset>
  </form>

  <!-- Thank-you panel replaces the form in place after a successful submit. -->
  <div id="booking-thanks" class="rounded-card border border-line bg-surface p-5 md:p-6" hidden tabindex="-1">
    <h3 class="text-h3">{thanks.h1}</h3>
    <p class="mt-2 text-body font-medium" data-thanks-summary></p>
    <ol class="mt-5 grid gap-3 text-body text-muted">
      {thanks.steps.map((step, i) => (
        <li class="flex gap-3">
          <span class="w-5 shrink-0 text-accent" aria-hidden="true">{i + 1}.</span>
          <span>{step}</span>
        </li>
      ))}
    </ol>
    <p class="mt-4 text-small text-muted">{thanks.ifUnavailable}</p>
    <a href={whatsappHref(footer.phone)} target="_blank" rel="noopener" class:list={['mt-6', primaryBtn]} data-cta="whatsapp">
      {thanks.cta}
    </a>
    <p class="mt-3 text-small text-muted">{thanks.ctaMicrocopy}</p>
    <p class="mt-4 text-small text-muted">
      <a href={links.instagram.url} target="_blank" rel="noopener" class="underline underline-offset-4" data-cta="instagram">{thanks.instagram}</a>
    </p>
    {DRAFT && <p class="mt-4 text-small text-muted">{form.thanksNote}</p>}
  </div>

  <aside class="mt-6 rounded-card border border-line p-5">
    <h3 class="text-h3">{whatsappBlock.heading}</h3>
    <p class="mt-2 text-body text-muted">{whatsappBlock.body}</p>
    <a href={waHref} target="_blank" rel="noopener" class="mt-4 inline-flex min-h-[48px] w-full items-center justify-center rounded-pill border border-ink px-5 text-body font-medium" data-cta="whatsapp">
      {whatsappBlock.cta}
    </a>
  </aside>

  <script is:inline type="application/json" id="booking-config" set:html={clientConfig} />
</Section>

<script>
  import {
    validateStep1,
    validateStep2,
    validateBooking,
    nowInRestaurantZone,
    addDaysIso,
    isSlotOpen,
    type FieldErrors,
    type ErrorKey,
  } from '@/lib/validation';

  interface Config {
    errors: Record<ErrorKey, string>;
    offerLabels: Record<string, string>;
    seatingLabels: Record<string, string>;
    summaryTemplate: string;
    ctaLoading: string;
    cta: string;
  }

  const form = document.getElementById('booking-form') as HTMLFormElement | null;
  const thanksPanel = document.getElementById('booking-thanks');
  const configEl = document.getElementById('booking-config');
  if (form && thanksPanel && configEl) init(form, thanksPanel, JSON.parse(configEl.textContent ?? '{}') as Config);

  function init(form: HTMLFormElement, thanksPanel: HTMLElement, cfg: Config) {
    const step1 = form.querySelector<HTMLFieldSetElement>('[data-step="1"]')!;
    const step2 = form.querySelector<HTMLFieldSetElement>('[data-step="2"]')!;
    const submitBtn = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const variantField = form.querySelector<HTMLInputElement>('[data-variant-field]');

    // Which hero variant the visitor saw — travels with the request.
    const variant = document.documentElement.dataset.variant ?? '';
    if (variantField) variantField.value = variant;

    // Defaults follow the promise the visitor clicked on: the "view" ad sold the
    // terrace, the "price" ad sold 20% off à la carte. Other variants keep the
    // content defaults. One tap still switches either.
    const preselect = (name: string, value: string) => {
      const radio = form.querySelector<HTMLInputElement>(`[name="${name}"][value="${value}"]`);
      if (radio) radio.checked = true;
    };
    if (variant === 'view') preselect('seating', 'terrace');
    if (variant === 'price') preselect('offer', 'alacarte');

    // --- Date: quick picks fill the native input; "Pick a date" reveals it. ---
    const dateInput = form.querySelector<HTMLInputElement>('[name="date"]')!;
    const quickBtns = Array.from(form.querySelectorAll<HTMLButtonElement>('[data-date-quick]'));
    const todayClosedNote = form.querySelector<HTMLElement>('[data-today-closed]');
    const slotLabels = Array.from(form.querySelectorAll<HTMLLabelElement>('[data-slot]'));
    const lastSlot = slotLabels[slotLabels.length - 1]?.dataset.slot ?? '';

    const setQuick = (which: string | null) => {
      quickBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.dateQuick === which)));
    };

    // Slots already gone today are disabled; a disabled selected slot is unselected.
    const refreshSlots = () => {
      const now = nowInRestaurantZone();
      for (const label of slotLabels) {
        const radio = label.querySelector<HTMLInputElement>('input')!;
        const open = !dateInput.value || isSlotOpen(dateInput.value, radio.value, now);
        radio.disabled = !open;
        label.classList.toggle('opacity-40', !open);
        label.classList.toggle('cursor-not-allowed', !open);
        if (!open && radio.checked) radio.checked = false;
      }
    };

    // "Today" only while a seating is still ahead in the restaurant's zone.
    const refreshToday = () => {
      const now = nowInRestaurantZone();
      const todayBtn = quickBtns.find((b) => b.dataset.dateQuick === 'today');
      const closed = !isSlotOpen(now.date, lastSlot, now);
      if (todayBtn) todayBtn.disabled = closed;
      if (todayClosedNote) todayClosedNote.hidden = !closed;
      dateInput.min = now.date;
      return { now, closed };
    };

    quickBtns.forEach((btn) =>
      btn.addEventListener('click', () => {
        const which = btn.dataset.dateQuick!;
        const { now } = refreshToday();
        if (which === 'pick') {
          dateInput.hidden = false;
          dateInput.focus();
          try { dateInput.showPicker?.(); } catch { /* not supported / needs gesture — the input is visible anyway */ }
        } else {
          dateInput.hidden = true;
          dateInput.value = which === 'today' ? now.date : addDaysIso(now.date, 1);
          dateInput.dispatchEvent(new Event('input', { bubbles: true }));
        }
        setQuick(which);
        refreshSlots();
      }),
    );

    // Typing/choosing a date in the native input keeps "Pick a date" pressed.
    dateInput.addEventListener('input', () => {
      if (!dateInput.hidden) setQuick('pick');
      refreshSlots();
    });

    refreshToday();
    refreshSlots();

    // --- Guests: pills fill the native input; "7+" reveals it. ---
    const guestsInput = form.querySelector<HTMLInputElement>('[name="guests"]')!;
    const guestsBtns = Array.from(form.querySelectorAll<HTMLButtonElement>('[data-guests-quick]'));
    const guestsMoreLabel = form.querySelector<HTMLElement>('[data-guests-more-label]');
    const moreFrom = Number(guestsInput.dataset.moreFrom);

    const setGuestsPill = (which: string | null) => {
      guestsBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.guestsQuick === which)));
    };
    const showGuestsInput = (show: boolean) => {
      guestsInput.hidden = !show;
      if (guestsMoreLabel) guestsMoreLabel.hidden = !show;
    };

    guestsBtns.forEach((btn) =>
      btn.addEventListener('click', () => {
        const which = btn.dataset.guestsQuick!;
        if (which === 'more') {
          showGuestsInput(true);
          if (Number(guestsInput.value) < moreFrom) guestsInput.value = String(moreFrom);
          guestsInput.focus();
          guestsInput.select();
        } else {
          showGuestsInput(false);
          guestsInput.value = which;
        }
        guestsInput.dispatchEvent(new Event('input', { bubbles: true }));
        setGuestsPill(which);
      }),
    );

    // Typing in the number input keeps "7+" pressed, whatever the number.
    guestsInput.addEventListener('input', () => {
      if (!guestsInput.hidden) setGuestsPill('more');
    });

    // If the value arrives pre-filled (back/forward cache) above the pill range, show the input.
    if (Number(guestsInput.value) >= moreFrom) {
      showGuestsInput(true);
      setGuestsPill('more');
    }

    // --- Notes: open the disclosure if it already holds text. ---
    const notes = form.querySelector<HTMLDetailsElement>('[data-notes]');
    const notesField = form.querySelector<HTMLTextAreaElement>('[name="notes"]');
    if (notes && notesField?.value.trim()) notes.open = true;

    const read = () => {
      const fd = new FormData(form);
      return {
        date: String(fd.get('date') ?? ''),
        time: String(fd.get('time') ?? ''),
        guests: String(fd.get('guests') ?? ''),
        seating: String(fd.get('seating') ?? ''),
        offer: String(fd.get('offer') ?? ''),
        name: String(fd.get('name') ?? ''),
        phone: String(fd.get('phone') ?? ''),
        notes: String(fd.get('notes') ?? ''),
        variant: String(fd.get('variant') ?? ''),
      };
    };

    // --- Errors: shown next to the field, never touching its value. ---
    const showErrors = (scope: HTMLElement, errors: FieldErrors) => {
      clearErrors(scope);
      let first: HTMLElement | null = null;
      for (const [field, key] of Object.entries(errors) as [string, ErrorKey][]) {
        const msg = scope.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
        if (msg) {
          msg.textContent = cfg.errors[key];
          msg.hidden = false;
        }
        scope
          .querySelectorAll<HTMLElement>(`[name="${field}"]`)
          .forEach((el) => el.setAttribute('aria-invalid', 'true'));
        // Focus the first visible control for the field (radio groups: the group's fieldset).
        const input = scope.querySelector<HTMLElement>(`[name="${field}"]`);
        const target = input && input.hidden ? input.closest<HTMLElement>('fieldset') : input;
        if (!first && target) first = target;
      }
      if (first) {
        if (!first.hasAttribute('tabindex') && first.tagName === 'FIELDSET') first.tabIndex = -1;
        first.focus({ preventScroll: false });
      }
    };

    const clearErrors = (scope: HTMLElement) => {
      scope.querySelectorAll<HTMLElement>('[data-error-for]').forEach((el) => {
        el.hidden = true;
        el.textContent = '';
      });
      scope.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
    };

    // First touch of any field: tell the page (sticky bar, later analytics `form_start`).
    form.addEventListener('input', () => {
      document.dispatchEvent(new CustomEvent('booking:start'));
    }, { once: true });

    // Clear a field's error as soon as the visitor edits it.
    form.addEventListener('input', (e) => {
      const name = (e.target as HTMLElement).getAttribute('name');
      if (!name) return;
      form.querySelector<HTMLElement>(`[data-error-for="${name}"]`)?.setAttribute('hidden', '');
      form.querySelectorAll(`[name="${name}"]`).forEach((i) => i.removeAttribute('aria-invalid'));
    });

    // --- Step switching ---
    const showStep = (n: 1 | 2) => {
      step1.hidden = n !== 1;
      step2.hidden = n !== 2;
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
      if (n === 2) step2.querySelector<HTMLElement>('input:not([type="hidden"])')?.focus({ preventScroll: true });
    };

    form.querySelector('[data-step-next]')?.addEventListener('click', () => {
      refreshSlots();
      const errors = validateStep1(read());
      if (Object.keys(errors).length) return showErrors(step1, errors);
      showStep(2);
    });

    form.querySelector('[data-step-back]')?.addEventListener('click', () => showStep(1));

    // --- Submit ---
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = read();
      const step2Errors = validateStep2(input);
      if (Object.keys(step2Errors).length) return showErrors(step2, step2Errors);

      const result = validateBooking(input);
      if (!result.ok) {
        // Step 1 went stale (e.g. the chosen slot passed while typing) — send them back to it.
        showStep(1);
        refreshSlots();
        return showErrors(step1, result.errors);
      }

      submitBtn.disabled = true;
      submitBtn.textContent = cfg.ctaLoading;
      try {
        // TODO(backend): POST result.value to the Cloudflare Function here.
        // Until then the draft simulates a short round-trip.
        await new Promise((r) => setTimeout(r, 600));
        showThanks(result.value);
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = cfg.cta;
      }
    });

    const showThanks = (v: { guests: number; date: string; time: string; seating: string; offer: string }) => {
      const date = new Date(`${v.date}T${v.time}:00`);
      // "No preference" is not worth a segment: drop {{SEATING}} and its separator.
      const template = v.seating === 'any'
        ? cfg.summaryTemplate.replace(/\s*·\s*\{\{SEATING\}\}/, '')
        : cfg.summaryTemplate;
      const summary = template
        .replace('{{GUESTS}}', String(v.guests))
        .replace('{{DATE}}', date.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' }))
        .replace('{{TIME}}', date.toLocaleTimeString('en-GB', { hour: 'numeric', minute: '2-digit', hour12: true }))
        .replace('{{SEATING}}', cfg.seatingLabels[v.seating] ?? v.seating)
        .replace('{{OFFER}}', cfg.offerLabels[v.offer] ?? v.offer);
      const summaryEl = thanksPanel.querySelector<HTMLElement>('[data-thanks-summary]');
      if (summaryEl) summaryEl.textContent = summary;

      form.hidden = true;
      thanksPanel.hidden = false;
      thanksPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
      thanksPanel.focus({ preventScroll: true });
    };
  }
</script>
