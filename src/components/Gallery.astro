---
import Section from '@/components/Section.astro';
import Carousel from '@/components/Carousel.astro';
import { content } from '@/content/schema';

const { gallery } = content;
// Every gallery photo is 3 / 2 — one ratio keeps the track height fixed.
const slides = gallery.items.map((item) => ({ src: item.src, alt: item.alt, title: item.caption }));
---

<Section id="gallery" heading={gallery.heading} sub={gallery.sub} body={gallery.body}>
  <Carousel slides={slides} aspect="3 / 2" width="85%" widthMd="48%" label={gallery.heading} />
</Section>
