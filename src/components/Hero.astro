---
import { content, HERO_VARIANTS, finalList } from '@/content/schema';

const { hero } = content;
const trust = finalList(hero.trustStrip);
---

<section data-hero class="relative flex min-h-[100svh] max-h-[812px] flex-col overflow-hidden text-white">
  <!-- Video placeholder. Real <video> with poster arrives in stage 3. -->
  <!-- The section itself is the fixed box (100svh, ≤812px); the video will use object-fit: cover. -->
  <div class="media-placeholder absolute inset-0 h-full w-full" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-overlay" aria-hidden="true"></div>

  <div class="relative mx-auto flex w-full max-w-[640px] flex-1 flex-col justify-end px-4 pb-8 pt-12 md:pb-12">
    <p class="text-small font-medium uppercase tracking-[0.12em] opacity-90">{hero.eyebrow}</p>

    {HERO_VARIANTS.map((id) => (
      <div data-hero-variant={id}>
        <h1 class="mt-4 text-h1 md:text-[48px] md:leading-[1.08]">{hero.variants[id].h1}</h1>
        <p class="mt-4 text-body opacity-90 md:text-[18px]">{hero.variants[id].sub}</p>
      </div>
    ))}

    <a
      href="#booking"
      class="mt-6 inline-flex min-h-[52px] w-full items-center justify-center rounded-pill bg-accent px-6 text-body font-medium text-accent-ink md:w-auto md:self-start"
      data-cta="hero"
    >
      {hero.cta}
    </a>
    <p class="mt-3 text-small opacity-80">{hero.ctaMicrocopy}</p>

    {trust.length > 0 && (
      <ul class="mt-6 flex flex-wrap gap-x-4 gap-y-1 border-t border-white/25 pt-4 text-small opacity-90">
        {trust.map((line) => <li>{line}</li>)}
      </ul>
    )}
  </div>
</section>
