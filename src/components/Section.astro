---
/** Shared block wrapper: consistent gutters, width and heading rhythm. */
interface Props {
  id?: string;
  heading: string;
  sub?: string | null;
  /** Optional paragraphs after the sub — for blocks that need a few sentences of atmosphere, not just a lead-in. */
  body?: string[] | null;
  class?: string;
  surface?: boolean;
}
const { id, heading, sub, body, class: className = '', surface = false } = Astro.props;
---

<section id={id} class:list={['py-12 md:py-16', surface && 'bg-surface', className]}>
  <div class="mx-auto w-full max-w-[640px] px-4">
    <header class="mb-6 md:mb-8">
      <h2 class="text-balance text-h2 md:text-[32px] md:leading-[1.15]">{heading}</h2>
      {sub && <p class="mt-3 text-body text-muted">{sub}</p>}
      {body?.map((p) => <p class="mt-4 text-body text-pretty">{p}</p>)}
    </header>
    <slot />
  </div>
</section>
