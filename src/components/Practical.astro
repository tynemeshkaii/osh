---
import Section from '@/components/Section.astro';
import { content, finalItems } from '@/content/schema';

const { practical, links } = content;
const items = finalItems(practical.items, ['body']);
// Directions link belongs with the first item ("Getting here").
const mapsIndex = 0;
---

<Section id="practical" heading={practical.heading}>
  <dl class="grid gap-6 md:grid-cols-2">
    {items.map((item, i) => (
      <div>
        <dt class="text-body font-medium">{item.label}</dt>
        <dd class="mt-1 text-body text-muted">
          {item.body}
          {i === mapsIndex && (
            <a href={links.maps.url} target="_blank" rel="noopener" class="mt-1 flex w-fit min-h-[44px] items-center text-ink underline underline-offset-4" data-cta="maps">
              {links.maps.label}
            </a>
          )}
        </dd>
      </div>
    ))}
  </dl>
</Section>
