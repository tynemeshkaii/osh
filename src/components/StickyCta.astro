---
import { content, HERO_VARIANTS } from '@/content/schema';

const { stickyCta } = content;
---

<div
  id="sticky-cta"
  class="fixed inset-x-0 bottom-0 z-50 translate-y-full border-t border-line bg-surface/95 px-4 pb-[max(12px,env(safe-area-inset-bottom))] pt-3 backdrop-blur transition-transform duration-300 data-[visible]:translate-y-0"
  aria-hidden="true"
>
  <div class="mx-auto flex max-w-[640px] items-center justify-between gap-4">
    <!-- One note per hero variant (the offer differs); the html[data-variant] CSS shows the active one.
         Renders "today" and swaps to "tomorrow" once the last seating has passed. -->
    <span class="min-w-0 text-[13px] leading-[1.45] text-muted" data-sticky-note data-note-resume={stickyCta.noteResume}>
      {HERO_VARIANTS.map((id) => (
        <span class="truncate" data-hero-variant={id} data-note-tomorrow={stickyCta.note[id].tomorrow}>{stickyCta.note[id].today}</span>
      ))}
    </span>
    <a href="#booking" class="inline-flex min-h-[48px] shrink-0 items-center justify-center whitespace-nowrap rounded-pill bg-accent px-5 text-body font-medium text-accent-ink" data-cta="sticky">
      {stickyCta.label}
    </a>
  </div>
</div>

<script>
  import { nowInRestaurantZone, isSlotOpen, TIME_SLOTS } from '@/lib/validation';

  // Show after the hero has scrolled away; hide while the form is on screen.
  const bar = document.getElementById('sticky-cta');
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const form = document.getElementById('booking');

  if (bar && hero && form && 'IntersectionObserver' in window) {
    let heroVisible = true;
    let formVisible = false;

    const apply = () => {
      const show = !heroVisible && !formVisible;
      bar.toggleAttribute('data-visible', show);
      bar.setAttribute('aria-hidden', String(!show));
    };

    new IntersectionObserver(([e]) => { heroVisible = !!e?.isIntersecting; apply(); }, { threshold: 0.1 }).observe(hero);
    new IntersectionObserver(([e]) => { formVisible = !!e?.isIntersecting; apply(); }, { threshold: 0 }).observe(form);
  }

  const note = bar?.querySelector<HTMLElement>('[data-sticky-note]');
  const variantNotes = Array.from(note?.querySelectorAll<HTMLElement>('[data-hero-variant]') ?? []);

  // Same rule as the form's "Today" pill: once the last seating has passed in
  // the restaurant's zone, the honest nudge is tomorrow's window.
  const now = nowInRestaurantZone();
  const lastSlot = TIME_SLOTS[TIME_SLOTS.length - 1] ?? '';
  if (!isSlotOpen(now.date, lastSlot, now)) {
    for (const el of variantNotes) if (el.dataset.noteTomorrow) el.textContent = el.dataset.noteTomorrow;
  }

  // Once the visitor has touched the form, the bar nudges them back to it.
  // `booking:start` is dispatched by BookingForm on the first input.
  if (note?.dataset.noteResume) {
    document.addEventListener('booking:start', () => {
      for (const el of variantNotes) el.textContent = note.dataset.noteResume!;
    }, { once: true });
  }
</script>
