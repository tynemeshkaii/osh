---
import Section from '@/components/Section.astro';
import { content, finalItems, finalText } from '@/content/schema';

const { socialProof } = content;
const ratingLine = finalText(socialProof.ratingLine);
const quotes = finalItems(socialProof.quotes, ['text', 'author']);
const press = socialProof.pressCaption.split(' · ');
---

<Section id="proof" heading={socialProof.heading} surface>
  {ratingLine && <p class="text-body font-medium">{ratingLine}</p>}

  {quotes.length > 0 && (
    <ul class="mt-6 space-y-4">
      {quotes.map((q) => (
        <li class="rounded-card border border-line p-5">
          <blockquote class="text-body">“{q.text}”</blockquote>
          <p class="mt-3 text-small text-muted">{q.author} · {q.source}</p>
        </li>
      ))}
    </ul>
  )}

  <!-- Press logos: text marks until real SVGs arrive. -->
  <ul class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-small font-medium uppercase tracking-[0.08em] text-muted" aria-label={socialProof.pressCaption}>
    {press.map((name) => <li>{name}</li>)}
  </ul>
</Section>
