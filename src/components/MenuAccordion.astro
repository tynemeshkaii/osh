---
import Section from '@/components/Section.astro';
import { content, finalItems } from '@/content/schema';

const { menu } = content;
const courses = finalItems(menu.courses, ['body']);
---

<Section id="menu" heading={menu.heading} sub={menu.sub} surface>
  {courses.length > 0 && (
    <div class="divide-y divide-line border-y border-line">
      {courses.map((course, i) => (
        <details class="group" open={i === 0} data-menu-course={i}>
          <summary class="flex min-h-[52px] items-center justify-between gap-4 py-3 text-h3">
            <span>{course.label}</span>
            <span class="text-muted transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="pb-5 text-body text-muted">{course.body}</p>
        </details>
      ))}
    </div>
  )}
  <p class="mt-6 text-body text-muted">{menu.closing}</p>
</Section>
